# Sao chep file nay thanh .env roi sua gia tri cho phu hop
APP_NAME=DGTT Backend
ENV=dev

# Ket noi PostgreSQL (driver asyncpg)
DATABASE_URL=postgresql+asyncpg://dgtt:dgtt@localhost:5432/dgtt

# JWT - BAT BUOC doi JWT_SECRET khi trien khai that
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cac origin frontend duoc phep goi API, phan tach bang dau phay
CORS_ORIGINS=http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500

# Luu tep upload
STORAGE_DIR=storage
MAX_UPLOAD_MB=10

# Bo lap lich tu chuyen trang thai phien
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=1

# Chi dung khi chay test can DB (tests danh dau @pytest.mark.db)
# TEST_DATABASE_URL=postgresql+asyncpg://dgtt:dgtt@localhost:5432/dgtt_test
